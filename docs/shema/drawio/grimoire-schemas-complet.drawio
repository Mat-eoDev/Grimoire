<diagram name="workflow-mj-joueurs" id="workflow_mj_joueurs"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title_2" value="Deroulement d'une campagne - MJ, code, scenes, actions et lancers de de" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;strokeColor=#0f172a;fontStyle=1;fontSize=18" vertex="1" parent="1"><mxGeometry x="40" y="30" width="920" height="50" as="geometry"/></mxCell><mxCell id="laneMj_3" value="Maitre du Jeu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="40" y="110" width="470" height="910" as="geometry"/></mxCell><mxCell id="laneApp_4" value="Application Grimoire / NewMJ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="560" y="110" width="470" height="910" as="geometry"/></mxCell><mxCell id="lanePlayers_5" value="Joueurs 1..n" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="560" height="910" as="geometry"/></mxCell><mxCell id="mj_6" value="Cree et lance la campagne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="170" width="270" height="70" as="geometry"/></mxCell><mxCell id="app_7" value="Genere un code de campagne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="170" width="270" height="70" as="geometry"/></mxCell><mxCell id="mj_8" value="Donne le code aux joueurs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="280" width="270" height="70" as="geometry"/></mxCell><mxCell id="players_9" value="Rejoignent la campagne avec le code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="320" height="70" as="geometry"/></mxCell><mxCell id="app_10" value="Associe chaque joueur a la campagne" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="390" width="270" height="70" as="geometry"/></mxCell><mxCell id="players_11" value="Visualisent la campagne et attendent les actions proposees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1160" y="500" width="360" height="80" as="geometry"/></mxCell><mxCell id="loop_12" value="&lt;b&gt;Boucle de narration pendant la partie&lt;/b&gt;&lt;br&gt;Le MJ garde le controle du rythme et peut repeter ces etapes autant que necessaire." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;dashed=1;fontStyle=1;align=left;verticalAlign=top;spacing=8" vertex="1" parent="1"><mxGeometry x="70" y="615" width="1510" height="360" as="geometry"/></mxCell><mxCell id="mj_13" value="Choisit une scene en background" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="680" width="270" height="70" as="geometry"/></mxCell><mxCell id="app_14" value="Met a jour la scene visible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="680" width="270" height="70" as="geometry"/></mxCell><mxCell id="players_15" value="Voient le decor propose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1180" y="680" width="320" height="70" as="geometry"/></mxCell><mxCell id="mj_16" value="Ajoute a volonte : ennemis, PNJ, objets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="790" width="270" height="80" as="geometry"/></mxCell><mxCell id="app_17" value="Enregistre les elements et leur visibilite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="790" width="270" height="80" as="geometry"/></mxCell><mxCell id="players_18" value="Voient uniquement les elements publies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1180" y="790" width="320" height="80" as="geometry"/></mxCell><mxCell id="mj_19" value="Propose une action a resoudre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="900" width="270" height="70" as="geometry"/></mxCell><mxCell id="app_20" value="Cree une demande de lancer de de" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="900" width="270" height="70" as="geometry"/></mxCell><mxCell id="players_21" value="Lance le de et envoie le resultat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1180" y="900" width="320" height="70" as="geometry"/></mxCell><mxCell id="app_22" value="Calcule l'issue et applique la consequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="1000" width="270" height="70" as="geometry"/></mxCell><mxCell id="mj_23" value="Continue la narration ou adapte la scene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontSize=12" vertex="1" parent="1"><mxGeometry x="130" y="1000" width="270" height="70" as="geometry"/></mxCell><mxCell id="players_24" value="Voient le resultat : narration, degats, objet ou changement de scene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12" vertex="1" parent="1"><mxGeometry x="1180" y="1000" width="320" height="80" as="geometry"/></mxCell><mxCell id="e_25" value="creation" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="mj_6" target="app_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_26" value="code" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_7" target="mj_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_27" value="partage hors application" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="mj_8" target="players_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_28" value="POST /campaigns/join" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="players_9" target="app_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_29" value="acces campagne" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_10" target="players_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_30" value="choix background" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="mj_13" target="app_14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_31" value="publication" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_14" target="players_15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_32" value="attente" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="players_15" target="players_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_33" value="ennemi / PNJ / objet" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="mj_16" target="app_17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_34" value="filtrage visible" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_17" target="players_18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_35" value="observation" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="players_18" target="players_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_36" value="demande de jet" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="mj_19" target="app_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_37" value="notification action" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_20" target="players_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_38" value="resultat du de" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="players_21" target="app_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_39" value="mise a jour" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_22" target="players_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_40" value="resultat pour arbitrage" style="endArrow=block;html=1;rounded=1;strokeWidth=2" edge="1" parent="1" source="app_22" target="mj_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_41" value="nouvelle scene ou nouvelle action" style="endArrow=block;html=1;rounded=1;strokeWidth=2;dashed=1" edge="1" parent="1" source="mj_23" target="mj_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note_42" value="A expliquer a l'oral : l'application ne remplace pas le MJ. Elle sert de support visuel, gere les acces joueurs, synchronise la scene et structure les lancers de de." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;align=left;verticalAlign=top;spacing=8;fontSize=12" vertex="1" parent="1"><mxGeometry x="1030" y="170" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
