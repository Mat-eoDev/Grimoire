{
  "name": "newmj",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev:server": "npm --workspace @newmj/server run dev",
    "dev:web": "npm --workspace @newmj/web run dev",
    "build": "npm --workspace @newmj/server run build && npm --workspace @newmj/web run build",
    "check": "npm --workspace @newmj/server run check && npm --workspace @newmj/web run check",
    "prisma:generate": "npm --workspace @newmj/server run prisma:generate",
    "prisma:migrate": "npm --workspace @newmj/server run prisma:migrate",
    "prisma:deploy": "npm --workspace @newmj/server run prisma:deploy",
    "prisma:seed": "npm --workspace @newmj/server run prisma:seed"
  }
}

