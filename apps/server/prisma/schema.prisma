generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum MemberRole {
  GM
  PLAYER
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  username     String           @unique
  passwordHash String
  status       AccountStatus    @default(ACTIVE)
  isAdmin      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  gmCampaigns  Campaign[]       @relation("CampaignGM")
  memberships  CampaignMember[]
  imageContexts ContextImage[]
  textContexts  ContextText[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id          String           @id @default(uuid())
  gmUserId    String
  gmUser      User             @relation("CampaignGM", fields: [gmUserId], references: [id])
  currentImageContextId String?
  currentImageContext   ContextImage? @relation("CampaignCurrentImageContext", fields: [currentImageContextId], references: [id])
  currentTextContextId  String?
  currentTextContext    ContextText?  @relation("CampaignCurrentTextContext", fields: [currentTextContextId], references: [id])
  title       String
  joinCode    String           @unique
  status      CampaignStatus   @default(DRAFT)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     CampaignMember[]
  publishedTextEntries CampaignPublishedText[]
}

model CampaignMember {
  id         String     @id @default(uuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole
  joinedAt   DateTime   @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, role])
}

model ContextImage {
  id         String     @id @default(uuid())
  name       String
  imageDataUrl String
  isBuiltin  Boolean    @default(false)
  ownerId    String?
  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  campaigns  Campaign[] @relation("CampaignCurrentImageContext")

  @@unique([name, ownerId])
  @@index([ownerId, createdAt])
  @@index([isBuiltin, createdAt])
}

model ContextText {
  id             String         @id @default(uuid())
  title          String
  content        String
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  campaigns      Campaign[]     @relation("CampaignCurrentTextContext")
  publishedInCampaigns CampaignPublishedText[]

  @@index([ownerId, createdAt])
  @@index([approvalStatus, createdAt])
}

model CampaignPublishedText {
  id            String      @id @default(uuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  textContextId String
  textContext   ContextText @relation(fields: [textContextId], references: [id], onDelete: Cascade)
  publishedAt   DateTime    @default(now())

  @@index([campaignId, publishedAt])
  @@index([textContextId, publishedAt])
}
