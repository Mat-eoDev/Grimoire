generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum MemberRole {
  GM
  PLAYER
}

enum SceneElementType {
  ENEMY
  NPC
  OBJECT
  NARRATION
}

enum ItemType {
  WEAPON
  SHIELD
  CONSUMABLE
  MISC
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  username     String           @unique
  passwordHash String
  status       AccountStatus    @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions         Session[]
  gmCampaigns      Campaign[]       @relation("CampaignGM")
  memberships      CampaignMember[]
  playerNotes      PlayerNote[]
  characterSheets  CharacterSheet[]
  inventoryEntries InventoryEntry[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id          String           @id @default(uuid())
  gmUserId    String
  gmUser      User             @relation("CampaignGM", fields: [gmUserId], references: [id])
  title       String
  joinCode    String           @unique
  status      CampaignStatus   @default(DRAFT)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members          CampaignMember[]
  playerNotes      PlayerNote[]
  characterSheets  CharacterSheet[]
  inventoryEntries InventoryEntry[]
  scenePreset      String           @default("RUINS")
  sceneTitle       String           @default("Les ruines sous la pluie")
  sceneText        String           @default("Un grondement sourd traverse les pierres anciennes.")
  sceneElements    SceneElement[]
}

model CampaignMember {
  id         String     @id @default(uuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole
  joinedAt   DateTime   @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, role])
}

model CharacterSheet {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  charId     Int
  charName   String

  // Stats de base — modifiables par le MJ plus tard
  hp         Int      @default(0)
  maxHp      Int      @default(0)
  attack     Int      @default(0)
  defense    Int      @default(0)
  speed      Int      @default(0)
  magic      Int      @default(0)
  level      Int      @default(1)

  updatedAt  DateTime @updatedAt

  @@unique([userId, campaignId])
  @@index([userId, campaignId])
}

model PlayerNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([userId, campaignId])
  @@index([userId, campaignId])
}

model SceneElement {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        SceneElementType
  name        String
  description String           @default("")
  quantity    Int              @default(1)
  isVisible   Boolean          @default(true)
  assetId     String?
  asset       RevelationAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([campaignId, isVisible])
  @@index([assetId])
}

model Item {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  type        ItemType
  imageFile   String
  description String           @default("")
  equipable   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  entries     InventoryEntry[]

  @@index([type])
}

model InventoryEntry {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Int      @default(1)
  equipped      Boolean  @default(false)
  bonusMaxHp    Int      @default(0)
  bonusAttack   Int      @default(0)
  bonusDefense  Int      @default(0)
  bonusSpeed    Int      @default(0)
  bonusMagic    Int      @default(0)
  effectHp      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([campaignId, userId])
  @@index([itemId])
}

model RevelationAsset {
  id           String           @id @default(uuid())
  type         SceneElementType
  name         String
  imageDataUrl String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  elements     SceneElement[]

  @@index([type])
}
