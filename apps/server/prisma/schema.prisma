generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum MemberRole {
  GM
  PLAYER
}

enum SceneElementType {
  ENEMY
  NPC
  OBJECT
  NARRATION
  PLAYER
}

enum ItemType {
  WEAPON
  SHIELD
  CONSUMABLE
  MISC
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
}

enum ActionRollStatus {
  PENDING
  ROLLED
  RESOLVED
  CANCELLED
}

enum ActionRollTargetType {
  NONE
  PLAYER
  ELEMENT
}

enum ActionRollConsequenceType {
  NONE
  NARRATION
  DAMAGE_TARGET
  DAMAGE_PLAYER
  DELETE_TARGET
  HEAL_PLAYER
}

enum CombatLogKind {
  ATTACK
  RESOLUTION
}

enum RollOutcome {
  TOTAL_FAILURE
  FAILURE
  SUCCESS
  TOTAL_SUCCESS
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  username     String           @unique
  passwordHash String
  status       AccountStatus    @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions         Session[]
  gmCampaigns      Campaign[]       @relation("CampaignGM")
  memberships      CampaignMember[]
  playerNotes      PlayerNote[]
  characterSheets  CharacterSheet[]
  inventoryEntries InventoryEntry[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Campaign {
  id          String           @id @default(uuid())
  gmUserId    String
  gmUser      User             @relation("CampaignGM", fields: [gmUserId], references: [id])
  title       String
  joinCode    String           @unique
  status      CampaignStatus   @default(DRAFT)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members          CampaignMember[]
  playerNotes      PlayerNote[]
  characterSheets  CharacterSheet[]
  inventoryEntries InventoryEntry[]
  scenePreset      String           @default("RUINS")
  sceneTitle       String           @default("Les ruines sous la pluie")
  sceneText        String           @default("Un grondement sourd traverse les pierres anciennes.")
  sceneElements    SceneElement[]
  actionRolls      ActionRoll[]
  tradeOffers      TradeOffer[]
  combatLog        CombatLogEntry[]
}

/// Trace automatique des coups portes et des resolutions de jet.
/// Ces evenements etaient auparavant ecrits comme des SceneElement de type NARRATION,
/// visibles par defaut et positionnes au centre de la scene : ils s'y empilaient sans
/// limite, etaient renvoyes en entier a chaque chargement de campagne et brouillaient
/// la mise en scene. Les SceneElement NARRATION restent reserves a la narration que le
/// MJ place volontairement.
model CombatLogEntry {
  id         String        @id @default(uuid())
  campaignId String
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       CombatLogKind
  message    String
  createdAt  DateTime      @default(now())

  @@index([campaignId, createdAt])
}

model TradeOffer {
  id               String      @id @default(uuid())
  campaignId       String
  campaign         Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromUserId       String
  toUserId         String
  offeredEntryId   String
  offeredQty       Int         @default(1)
  requestedEntryId String?
  requestedQty     Int         @default(1)
  status           TradeStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([campaignId, toUserId, status])
  @@index([campaignId, fromUserId, status])
}

model CampaignMember {
  id         String     @id @default(uuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole
  isReady    Boolean    @default(false)
  joinedAt   DateTime   @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, role])
}

model CharacterSheet {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  charId     Int
  charName   String

  // Stats de base — modifiables par le MJ plus tard
  hp         Int      @default(0)
  maxHp      Int      @default(0)
  attack     Int      @default(0)
  defense    Int      @default(0)
  speed      Int      @default(0)
  magic      Int      @default(0)
  level      Int      @default(1)

  updatedAt  DateTime @updatedAt

  @@unique([userId, campaignId])
  @@index([userId, campaignId])
}

model PlayerNote {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([userId, campaignId])
  @@index([userId, campaignId])
}

model SceneElement {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        SceneElementType
  name        String
  description String           @default("")
  quantity    Int              @default(1)
  isVisible   Boolean          @default(true)
  hp          Int              @default(0)
  maxHp       Int              @default(0)
  attack      Int              @default(0)
  defense     Int              @default(0)
  posX        Float            @default(50)
  posY        Float            @default(50)
  scale       Float            @default(1)
  assetId     String?
  asset       RevelationAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([campaignId, isVisible])
  @@index([assetId])
}

model ActionRoll {
  id                 String                    @id @default(uuid())
  campaignId         String
  campaign           Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  playerUserId       String
  actionText         String
  dieSides           Int                       @default(20)
  totalFailureMax    Int                       @default(4)
  successMin         Int                       @default(12)
  totalSuccessMin    Int                       @default(18)
  targetType         ActionRollTargetType      @default(NONE)
  targetElementId    String?
  targetUserId       String?
  status             ActionRollStatus          @default(PENDING)
  result             Int?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  // Une ligne par palier de resultat, au lieu des 15 colonnes plates precedentes.
  consequences       ActionRollConsequence[]

  @@index([campaignId, status])
  @@index([playerUserId, status])
  @@index([targetElementId])
  @@index([targetUserId])
}

/// Effet a appliquer pour un palier de resultat donne d'un jet d'action.
/// Remplace les 15 colonnes `<palier>Consequence<Type|Amount|Text>` portees par
/// ActionRoll : ajouter un palier ne demande plus de migration de colonnes, et
/// l'unicite (jet, palier) est garantie par la base.
model ActionRollConsequence {
  id       String                    @id @default(uuid())
  rollId   String
  roll     ActionRoll                @relation(fields: [rollId], references: [id], onDelete: Cascade)
  outcome  RollOutcome
  type     ActionRollConsequenceType @default(NONE)
  amount   Int                       @default(0)
  text     String                    @default("")

  @@unique([rollId, outcome])
  @@index([rollId])
}

model Item {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  type        ItemType
  imageFile   String
  description String           @default("")
  equipable   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  entries     InventoryEntry[]

  @@index([type])
}

model InventoryEntry {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity      Int      @default(1)
  equipped      Boolean  @default(false)
  bonusMaxHp    Int      @default(0)
  bonusAttack   Int      @default(0)
  bonusDefense  Int      @default(0)
  bonusSpeed    Int      @default(0)
  bonusMagic    Int      @default(0)
  effectHp      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([campaignId, userId])
  @@index([itemId])
}

model RevelationAsset {
  id           String           @id @default(uuid())
  type         SceneElementType
  name         String
  imageDataUrl String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  elements     SceneElement[]

  @@index([type])
}
